{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/knowledge.schema.json",
  "title": "Atlas Knowledge Object",
  "description": "Canonical knowledge object used by Atlas after source content has been discovered, mirrored, normalised and packaged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "slug",
    "status",
    "content",
    "source",
    "timestamps"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable Atlas identifier that remains unchanged across republishes."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "body"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "html",
            "plain_text"
          ]
        },
        "body": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "default": "en"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector",
        "external_id"
      ],
      "properties": {
        "connector": {
          "type": "string",
          "minLength": 1
        },
        "external_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "space": {
          "type": "string"
        },
        "parent_external_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingested_at"
      ],
      "properties": {
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "products": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "customer",
              "support",
              "developer",
              "internal",
              "partner"
            ]
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Reference to an Atlas asset identifier."
      },
      "uniqueItems": true,
      "default": []
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "parent",
              "child",
              "related",
              "references",
              "supersedes",
              "duplicate_of"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "default": []
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Connector-specific metadata that does not belong in the canonical fields.",
      "additionalProperties": true,
      "default": {}
    }
  }
}
