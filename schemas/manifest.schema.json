{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/manifest.schema.json",
  "title": "Atlas Canonical Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "connector", "generated_at", "root_page_id", "space_id", "object_count", "asset_count", "objects", "assets", "crawl_successful", "failures"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "connector": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "root_page_id": {"type": "string", "minLength": 1},
    "space_id": {"type": "string", "minLength": 1},
    "object_count": {"type": "integer", "minimum": 0},
    "asset_count": {"type": "integer", "minimum": 0},
    "objects": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "assets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "crawl_successful": {"type": "boolean"},
    "failures": {"type": "array", "items": {"type": "object"}}
  }
}
